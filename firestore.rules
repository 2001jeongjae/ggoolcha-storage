rules_version = '2';

// STORAGE 보안 규칙
// - 입장 코드를 맞힌 기기(members 명단)만 재고 데이터를 읽고 쓸 수 있다. 화면은 창을 열 때마다 코드를 다시 확인한다.
// - 입장 코드는 config/club 문서의 code 값. 이 문서는 누구도 앱에서 읽거나 고칠 수 없고,
//   Firebase 콘솔에서만 바꾼다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function clubCode() {
      return get(/databases/$(database)/documents/config/club).data.code;
    }
    // 명단에 적힌 코드가 지금 입장 코드와 같아야 한다 (코드를 바꾸면 모두 다시 입력)
    function isMember() {
      return signedIn()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.code == clubCode();
    }

    // 입장 코드 보관함: 앱에서는 절대 못 읽음
    match /config/{docId} {
      allow read, write: if false;
    }

    // 동아리 명단: 자기 기기 한 줄만, 코드가 맞을 때만 만들 수 있음
    match /members/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'joinedAt'])
        && request.resource.data.code == clubCode();
      allow list, delete: if false;
    }

    // 재고 데이터와 사진
    match /items/{id}     { allow read, write: if isMember(); }
    match /loans/{id}     { allow read, write: if isMember(); }
    match /purchases/{id} { allow read, write: if isMember(); }
    match /ships/{id}     { allow read, write: if isMember(); }
    match /photos/{id}    { allow read, create, delete: if isMember(); }

    // 소개 페이지(/intro)의 설치 신청서: 누구나 한 번 쓰기만 가능, 읽기·고치기는 Firebase 콘솔에서만
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(['club', 'school', 'name', 'contact', 'plan', 'memo', 'consent', 'createdAt'])
        && request.resource.data.club is string && request.resource.data.club.size() > 0 && request.resource.data.club.size() <= 60
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.contact is string && request.resource.data.contact.size() > 0 && request.resource.data.contact.size() <= 80
        && request.resource.data.get('school', '') is string && request.resource.data.get('school', '').size() <= 60
        && request.resource.data.get('memo', '') is string && request.resource.data.get('memo', '').size() <= 500
        && request.resource.data.plan in ['상담', '기본', '프로']
        && request.resource.data.consent == true
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
